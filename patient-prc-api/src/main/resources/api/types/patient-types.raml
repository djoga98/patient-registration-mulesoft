#%RAML 1.0 Library
usage: Data types of the patient registration process (portal field names).

types:
  PatientId:
    type: string
    description: Patient identifier generated by the System API, PAT- plus six digits.
    pattern: ^PAT-[0-9]{6}$
    example: PAT-000123

  PersonName:
    type: string
    description: Name as entered; must contain at least one non-blank character.
    pattern: ^\s*\S[\s\S]*$
    maxLength: 100

  EmailAddress:
    type: string
    pattern: ^[^@\s]+@[^@\s]+\.[^@\s]+$
    maxLength: 254

  PhoneNumber:
    type: string
    description: Digits with an optional leading +; spaces, dashes and brackets are allowed and removed.
    pattern: ^[+0-9 ()\-]{3,32}$

  Gender:
    type: string
    enum: [ female, male, other ]

  PatientRegistration:
    type: object
    description: A registration request from a channel such as the patient portal.
    properties:
      firstName: PersonName
      lastName: PersonName
      dateOfBirth:
        type: date-only
        description: yyyy-MM-dd
      gender: Gender
      contact:
        type: object
        properties:
          email: EmailAddress
          phone?: PhoneNumber | nil
      consents:
        type: object
        properties:
          dataProcessing: boolean
          smsReminders?: boolean | nil
      channel:
        type: string
        description: Registration channel, stored as the record source.
        pattern: ^[A-Z][A-Z_]{1,19}$
        example: PORTAL

  Patient:
    type: object
    description: A registered patient in portal field names.
    properties:
      patientId: PatientId
      firstName: string
      lastName: string
      dateOfBirth: date-only
      gender: Gender
      category:
        type: string
        enum: [ MINOR, ADULT, SENIOR ]
      contact:
        type: object
        properties:
          email: string
          phone?: string
      consents:
        type: object
        properties:
          dataProcessing: boolean
          smsReminders: boolean
      status:
        type: string
        enum: [ ACTIVE, INACTIVE ]
      registeredAt:
        type: datetime
        format: rfc3339

  ErrorResponse:
    type: object
    description: Error body shared by all three patient APIs.
    properties:
      error:
        type: object
        properties:
          code:
            type: string
          message:
            type: string
          correlationId:
            type: string
          timestamp:
            type: datetime
            format: rfc3339
