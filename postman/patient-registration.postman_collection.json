            "exec": [
              "pm.test('201, not 409 DUPLICATE_PATIENT', () => pm.response.to.have.status(201));",
              "pm.test('marked as replayed', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
              "pm.test('same body as the first response', () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('idempotentPatient'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patients"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Nina\",\n  \"lastName\": \"Horvat\",\n  \"dateOfBirth\": \"1990-03-15\",\n  \"gender\": \"female\",\n  \"contact\": {\n    \"email\": \"nina.horvat@example.com\"\n  },\n  \"consents\": {\n    \"dataProcessing\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
