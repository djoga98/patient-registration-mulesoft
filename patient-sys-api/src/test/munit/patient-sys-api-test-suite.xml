    <!-- ===================================================== protocol / routing -->

    <!-- =========================================== GET /api/patients?family_name= -->

    <munit:test name="search-returns-matching-records-in-record-format"
                description="The family name is used exactly as given; every row is mapped to the record contract, in database order">
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="patient-sys-api-main"/>
            <munit:enable-flow-source value="get:\patients:patient-sys-api-config"/>
        </munit:enable-flow-sources>
        <munit:behavior>
            <munit-tools:spy processor="db:select">
                <munit-tools:before-call>
                    <munit-tools:assert-equals actual="#[vars.familyName]" expected="#['Kovač']"
                                               message="No normalisation in the System API"/>
                </munit-tools:before-call>
            </munit-tools:spy>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[do { var row = readUrl('classpath://samples/patient-row.json', 'application/json') --- [ row, (row -- ['patient_id', 'given_name', 'phone']) ++ { patient_id: 'PAT-000124', given_name: 'Ivana', phone: null } ] }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[null]"/>
            <set-variable variableName="method" value="GET"/>
            <set-variable variableName="path" value="/api/patients"/>
            <set-variable variableName="queryParams" value="#[{ family_name: 'Kovač' }]"/>
            <set-variable variableName="requestHeaders" value="#[{ 'X-Correlation-ID': 'sys-search-001' }]"/>
            <flow-ref name="call-sys-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[attributes.statusCode]" expected="#[200]"/>
            <munit-tools:assert-equals actual="#[attributes.headers.'x-correlation-id']" expected="#['sys-search-001']"/>
            <munit-tools:assert-equals actual="#[payload.patient_id]" expected="#[['PAT-000123', 'PAT-000124']]"/>
            <munit-tools:assert-equals actual="#[payload[0] orderBy $$]"
                                       expected="#[(readUrl('classpath://samples/record-input.json', 'application/json') ++ { patient_id: 'PAT-000123', status: 'ACTIVE', registered_at: '2026-10-15T10:21:07Z' }) orderBy $$]"/>
            <munit-tools:assert-equals actual="#[payload[1].phone?]" expected="#[false]" message="NULL phone is omitted"/>
            <munit-tools:verify-call processor="db:select" times="1"/>
        </munit:validation>
    </munit:test>

