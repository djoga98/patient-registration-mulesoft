    <!-- ========================================================== correlation ID -->

    <munit:test name="incoming-correlation-id-is-the-event-correlation-id"
                description="The X-Correlation-ID header becomes both vars.correlationId and the runtime correlation ID used in every log line">
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="patient-sys-api-main"/>
            <munit:enable-flow-source value="post:\patients:application\json:patient-sys-api-config"/>
            <munit:enable-flow-source value="get:\patients\(patientId):patient-sys-api-config"/>
        </munit:enable-flow-sources>
        <munit:behavior>
            <munit-tools:spy processor="db:select">
                <munit-tools:before-call>
                    <munit-tools:assert-equals actual="#[vars.correlationId]" expected="#['sys-cid-777']"/>
                    <munit-tools:assert-equals actual="#[correlationId]" expected="#['sys-cid-777']"
                                               message="Logged correlation ID (MDC) must equal the propagated value"/>
                </munit-tools:before-call>
            </munit-tools:spy>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[ readUrl('classpath://samples/patient-row.json', 'application/json') ]]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[null]"/>
            <set-variable variableName="method" value="GET"/>
            <set-variable variableName="path" value="/api/patients/PAT-000123"/>
            <set-variable variableName="requestHeaders" value="#[{ 'X-Correlation-ID': 'sys-cid-777' }]"/>
            <flow-ref name="call-sys-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[attributes.statusCode]" expected="#[200]"/>
            <munit-tools:verify-call processor="db:select" times="1"/>
        </munit:validation>
    </munit:test>

    <munit:test name="missing-correlation-id-is-generated-as-uuid"
                description="Without X-Correlation-ID the API generates a UUID and uses it in the header and error body">
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="patient-sys-api-main"/>
            <munit:enable-flow-source value="post:\patients:application\json:patient-sys-api-config"/>
            <munit:enable-flow-source value="get:\patients\(patientId):patient-sys-api-config"/>
        </munit:enable-flow-sources>
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[]]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[null]"/>
            <set-variable variableName="method" value="GET"/>
            <set-variable variableName="path" value="/api/patients/PAT-000001"/>
            <flow-ref name="call-sys-api"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[attributes.statusCode]" expected="#[404]"/>
            <munit-tools:assert-that expression="#[attributes.headers.'x-correlation-id']"
                                     is="#[MunitTools::matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\$')]"/>
            <munit-tools:assert-equals actual="#[payload.error.correlationId]" expected="#[attributes.headers.'x-correlation-id']"/>
        </munit:validation>
    </munit:test>
