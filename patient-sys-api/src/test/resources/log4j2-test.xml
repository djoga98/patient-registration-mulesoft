<?xml version="1.0" encoding="UTF-8"?>
<!-- MUnit: the application's JSON line layout (see src/main/resources/log4j2.xml), written to the console. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout alwaysWriteExceptions="false">
                <Pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%p","logger":"%enc{%c}{JSON}","thread":"%enc{%t}{JSON}","app":"patient-sys-api","correlationId":"%enc{%X{correlationId}}{JSON}","message":"%enc{%m}{JSON}"%notEmpty{,"exception":"%enc{%ex}{JSON}"}}%n</Pattern>
            </PatternLayout>
        </Console>
    </Appenders>
    <Loggers>
        <AsyncLogger name="org.mule.service.http" level="WARN"/>
        <AsyncLogger name="org.mule.extension.http" level="WARN"/>
        <AsyncLogger name="org.mule.extension.db" level="WARN"/>
        <AsyncLogger name="com.acme.patient" level="INFO"/>
        <AsyncRoot level="WARN">
            <AppenderRef ref="console"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
