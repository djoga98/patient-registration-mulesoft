#%RAML 1.0 Library
usage: Data types of the patient database record format (snake_case).

types:
  PatientId:
    type: string
    description: Patient identifier generated by the System API, PAT- plus six digits.
    pattern: ^PAT-[0-9]{6}$
    example: PAT-000123

  PatientRecordInput:
    type: object
    description: Patient record to store, in the database record format.
    properties:
      given_name:
        type: string
        minLength: 1
        maxLength: 100
      family_name:
        type: string
        minLength: 1
        maxLength: 100
      birth_date:
        type: date-only
      sex:
        type: string
        enum: [ F, M, O ]
      category:
        type: string
        enum: [ MINOR, ADULT, SENIOR ]
      email:
        type: string
        minLength: 3
        maxLength: 254
      phone?:
        type: string
        minLength: 1
        maxLength: 32
      consent_data_processing:
        type: boolean
      consent_sms:
        type: boolean
      source:
        type: string
        minLength: 1
        maxLength: 20

  PatientRecord:
    type: PatientRecordInput
    description: Stored patient record including the fields generated by the System API.
    properties:
      patient_id: PatientId
      status:
        type: string
        enum: [ ACTIVE, INACTIVE ]
      registered_at:
        type: datetime
        format: rfc3339
        description: Registration instant in UTC.

  ErrorResponse:
    type: object
    description: Error body shared by all three patient APIs.
    properties:
      error:
        type: object
        properties:
          code:
            type: string
          message:
            type: string
          correlationId:
            type: string
          timestamp:
            type: datetime
            format: rfc3339
