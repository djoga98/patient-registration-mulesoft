<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- CI replaces this groupId with the Anypoint organization ID before publishing to Exchange. -->
    <groupId>com.acme.clinic</groupId>
    <artifactId>patient-exp-api</artifactId>
    <version>1.0.0</version>
    <packaging>mule-application</packaging>
    <name>patient-exp-api</name>
    <description>Patient Experience API: portal-facing contract.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Runtime MUnit runs the tests on. -->
        <app.runtime>4.12.2</app.runtime>
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>
        <munit.version>3.7.3</munit.version>

        <http.connector.version>1.11.3</http.connector.version>
        <apikit.version>1.12.2</apikit.version>
        <sockets.connector.version>1.2.9</sockets.connector.version>
        <objectstore.connector.version>1.3.1</objectstore.connector.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <runtimeVersion>${app.runtime}</runtimeVersion>
                    <runtimeProduct>MULE_EE</runtimeProduct>
                    <!-- UTF-8 regardless of the build machine (CloudHub runs UTF-8); Windows defaults to a legacy code page. -->
                    <argLines>
                        <argLine>-Dfile.encoding=UTF-8</argLine>
                    </argLines>
                    <systemPropertyVariables>
                        <env>test</env>
                    </systemPropertyVariables>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <!-- The build fails below this application coverage. -->
                        <failBuild>true</failBuild>
                        <requiredApplicationCoverage>90</requiredApplicationCoverage>
                        <formats>
                            <format>console</format>
                            <format>html</format>
                            <format>json</format>
                            <format>sonar</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- Declared directly: global.xml uses sockets:tcp-client-socket-properties (connect timeout). -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>${sockets.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- Idempotency-Key store (idempotency.xml). -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-objectstore-connector</artifactId>
            <version>${objectstore.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>${apikit.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      CloudHub 2.0 deployment (shared space, smallest replica). Used only by the CD workflow:
        mvn -P cloudhub2 deploy -DmuleDeploy
      publishes the application to Exchange (groupId must be the business group ID; the
      workflow sets it) and deploys it. Credentials come from environment variables that
      the workflow fills from GitHub Secrets; the client secret is a secure property.
    -->
    <profiles>
        <profile>
            <id>cloudhub2</id>
            <properties>
                <cloudhub.environment>Sandbox</cloudhub.environment>
                <cloudhub.target>Cloudhub-US-East-2</cloudhub.target>
                <!-- Runtime line 4.12 (LTS channel, Java 17). Override with -Dcloudhub.muleVersion
                     to a version listed in Runtime Manager if this patch is not offered. -->
                <cloudhub.muleVersion>4.12.5</cloudhub.muleVersion>
                <cloudhub.releaseChannel>LTS</cloudhub.releaseChannel>
                <cloudhub.applicationName>${project.artifactId}</cloudhub.applicationName>
                <cloudhub.env>dev</cloudhub.env>
            </properties>
            <distributionManagement>
                <repository>
                    <id>anypoint-exchange-v3</id>
                    <name>Anypoint Exchange</name>
                    <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${env.ANYPOINT_BUSINESS_GROUP_ID}/maven</url>
                    <layout>default</layout>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.mule.tools.maven</groupId>
                        <artifactId>mule-maven-plugin</artifactId>
                        <version>${mule.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <classifier>mule-application</classifier>
                            <cloudhub2Deployment>
                                <uri>https://anypoint.mulesoft.com</uri>
                                <provider>MC</provider>
                                <environment>${cloudhub.environment}</environment>
                                <target>${cloudhub.target}</target>
                                <muleVersion>${cloudhub.muleVersion}</muleVersion>
                                <releaseChannel>${cloudhub.releaseChannel}</releaseChannel>
                                <javaVersion>17</javaVersion>
                                <applicationName>${cloudhub.applicationName}</applicationName>
                                <replicas>1</replicas>
                                <vCores>0.1</vCores>
                                <businessGroupId>${env.ANYPOINT_BUSINESS_GROUP_ID}</businessGroupId>
                                <connectedAppClientId>${env.ANYPOINT_CLIENT_ID}</connectedAppClientId>
                                <connectedAppClientSecret>${env.ANYPOINT_CLIENT_SECRET}</connectedAppClientSecret>
                                <connectedAppGrantType>client_credentials</connectedAppGrantType>
                                <deploymentTimeout>900000</deploymentTimeout>
                                <!-- The persistent idempotency store uses Object Store v2 (shared by replicas). -->
                                <integrations>
                                    <services>
                                        <objectStoreV2>
                                            <enabled>true</enabled>
                                        </objectStoreV2>
                                    </services>
                                </integrations>
                                <properties>
                                    <env>${cloudhub.env}</env>
                                    <processApi.host>${env.PRC_API_HOST}</processApi.host>
                                    <!-- This app's client application for the Process API (empty: none sent). -->
                                    <processApi.clientId>${env.PRC_API_CLIENT_ID}</processApi.clientId>
                                </properties>
                                <secureProperties>
                                    <processApi.clientSecret>${env.PRC_API_CLIENT_SECRET}</processApi.clientSecret>
                                </secureProperties>
                            </cloudhub2Deployment>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
