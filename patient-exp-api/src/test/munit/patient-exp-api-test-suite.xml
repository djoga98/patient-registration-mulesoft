        <munit:execution>
            <set-payload value="#[null]"/>
            <set-variable variableName="method" value="GET"/>
            <set-variable variableName="path" value="/api/patients/PAT-000123"/>
            <set-variable variableName="requestHeaders" value="#[{ 'X-Correlation-ID': '6f1c2a9e-0b7d-4c1e-9a52-3c4d5e6f7a8b' }]"/>
