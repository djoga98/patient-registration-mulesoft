#%RAML 1.0
title: Patient Experience API
description: |
  Portal-facing contract for patient registration. Accepts or creates the
  correlation ID (X-Correlation-ID), forwards registrations to the Patient
  Registration Process API with channel PORTAL, and shapes responses for the
  portal (full name, age on the day of the request).
version: v1
mediaType: application/json
protocols: [ HTTP, HTTPS ]

traits:
  correlated: !include traits/correlated.raml

uses:
  portal: types/portal-types.raml

/patients:
  post:
    displayName: Register a new patient
    is: [ correlated ]
    headers:
      Idempotency-Key:
        type: string
        required: false
        pattern: ^[A-Za-z0-9._:-]{1,64}$
        description: |
          Optional; a UUID is recommended. A repeat of the same request with the same key
          within 24 hours returns the original 201 response (header
          Idempotent-Replayed: true) without registering again. Only a 201 is remembered;
          after an error the same key can be retried.
        example: 3b6f0c1e-8d2a-4f6e-9b1c-7a5d4e3f2a10
    body:
      application/json:
        type: portal.PortalRegistration
        example: !include examples/portal-registration.json
    responses:
      201:
        headers:
          Location:
            type: string
            example: /api/patients/PAT-000123
          Idempotent-Replayed:
            type: string
            required: false
            enum: [ "true" ]
            description: Present when the response is the stored response of an earlier request with the same Idempotency-Key.
        body:
          application/json:
            type: portal.PortalPatient
            example: !include examples/portal-patient.json
      400:
        body:
          application/json:
            type: portal.ErrorResponse
      409:
        description: |
          DUPLICATE_PATIENT: a patient with the same name and date of birth already exists.
          IDEMPOTENCY_KEY_IN_PROGRESS: a request with the same Idempotency-Key is still running.
        body:
          application/json:
            type: portal.ErrorResponse
            example: !include examples/error-duplicate.json
      422:
        description: INVALID_BIRTH_DATE, CONSENT_REQUIRED, or IDEMPOTENCY_KEY_MISMATCH (the key was used for a different request).
        body:
          application/json:
            type: portal.ErrorResponse
      500:
        body:
          application/json:
            type: portal.ErrorResponse
      502:
        description: A lower API is unreachable or timed out.
        body:
          application/json:
            type: portal.ErrorResponse

  get:
    displayName: Search patients by last name
    description: |
      Patients with the given last name, in the portal view. Case and surrounding spaces
      do not matter ("kovač" finds "Kovač"). Ordered by patient ID; at most 100 patients.
    is: [ correlated ]
    queryParameters:
      lastName:
        type: portal.PersonName
        example: kovač
    responses:
      200:
        description: The matching patients; an empty array when none match.
        body:
          application/json:
            type: portal.PortalPatient[]
            example: !include examples/portal-patients.json
      400:
        body:
          application/json:
            type: portal.ErrorResponse
      500:
        body:
          application/json:
            type: portal.ErrorResponse
      502:
        description: A lower API is unreachable, timed out or unavailable after retries.
        body:
          application/json:
            type: portal.ErrorResponse

  /{patientId}:
    uriParameters:
      patientId: portal.PatientId
    get:
      displayName: Read one patient
      is: [ correlated ]
      responses:
        200:
          body:
            application/json:
              type: portal.PortalPatient
              example: !include examples/portal-patient.json
        400:
          body:
            application/json:
              type: portal.ErrorResponse
        404:
          body:
            application/json:
              type: portal.ErrorResponse
        500:
          body:
            application/json:
              type: portal.ErrorResponse
        502:
          description: A lower API is unreachable, timed out or unavailable after retries.
          body:
            application/json:
              type: portal.ErrorResponse
