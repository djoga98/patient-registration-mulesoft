# Copy to infrastructure/.env (git-ignored) and replace every value.
# These are local-only credentials for the Docker database.

# Schema owner (used only by the container init scripts and the reset script)
POSTGRES_PASSWORD=change-me-owner
# Runtime account used by patient-sys-api (SELECT/INSERT only)
APP_DB_PASSWORD=change-me-app
# Host port for PostgreSQL
POSTGRES_PORT=5432

# Key for Mule Secure Configuration Properties, local environment only.
# AES-128 needs exactly 16 characters. Generate one with:
#   openssl rand -base64 12
MULE_SECURE_KEY=change-me-16-chr
